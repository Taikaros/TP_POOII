@startuml
left to right direction
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 60
skinparam classAttributeIconSize 1
skinparam packageStyle rectangle

' ==========================================
' 1. MÓDULO DE PERSONAS Y ROLES
' ==========================================
package "1. Gestion de Personal y Alumnos" as PkgPersonas {
  abstract class Persona {
    # nombre: String
    # apellido: String
    # dni: String
    # fechaNacimiento: Date
  }

  class Alumno {
    - legajoAlumno: String
    - estadoAcademico: EstadoAlumno
    + inscribirACursada(c: Cursada): InscripcionCursada
    + inscribirAMesa(m: MesaExamen): InscripcionExamen
  }

  abstract class Docente {
    # legajoDocente: String
    # cargaTrabajoDocente: Integer
    # horarioDocente: DateTime
    # antiguedadDocente: Integer
    # sueldoDocente: Decimal
    + cargarNotaRegularidad(i: InscripcionCursada, nota: Decimal, est: EstadoMateria): void
    + asentarCalificacionActa(a: ActaExamen, al: Alumno, nota: Decimal): void
  }

  class Titular {
    - dedicacionTitular: String
  }
  class Adjunto {
    - dedicacionAdjunto: String
    - categoriaAdjunto: String
  }
  class JTP {
    - cantidadComisiones: Integer
    - dedicacionJTP: String
  }
  class Auxiliar {
    - nivelAuxiliar: String
    - dedicacionAuxiliar: String
  }

  abstract class NoDocente {
    # legajoNoDocente: String
    # cargaTrabajoNoDocente: Integer
    # antiguedadNoDocente: Integer
    # sueldoNoDocente: Decimal
  }

  class Bedelia {
    - turno: String
    + crearLlamadoMesa(m: Materia, fecha: DateTime): MesaExamen
    + asignarAulaACursada(a: Aula, c: Cursada): Boolean
    + asignarAulaAMesa(a: Aula, m: MesaExamen): Boolean
    + inhabilitarEspacio(a: Aula, motivo: String): void
    + verificarSuperposicionHoraria(a: Aula, h: DateTime): Boolean
  }

  class Administrativo {
    - areaAdministrativa: String
    - funcionAdministrativa: String
  }

  Persona <|-- Alumno
  Persona <|-- Docente
  Persona <|-- NoDocente

  Docente <|-- Titular
  Docente <|-- Adjunto
  Docente <|-- JTP
  Docente <|-- Auxiliar

  NoDocente <|-- Bedelia
  NoDocente <|-- Administrativo
}

' ==========================================
' 2. MÓDULO DE OPERATORIA (CURSADAS Y MESAS)
' ==========================================
package "2. Cursadas, Mesas e Inscripciones" as PkgOperatoria {
  class InscripcionCursada {
    - codigoInscripcion: String
    - fechaEmision: DateTime
    - notaRegularidad: Decimal
    - condicionFinal: EstadoMateria
    + validarCorrelativas(al: Alumno): Boolean
  }

  class Cursada {
    - codigoComision: String
    - anioLectivo: Integer
    - horario: DateTime
    - cupoMaximo: Integer
    + validarCupoDisponible(): Boolean
  }

  class InscripcionExamen {
    - codigoInscripcion: String
    - fechaEmision: DateTime
    + validarEstadoAcademico(al: Alumno): Boolean
  }

  class MesaExamen {
    - codigoMesa: String
    - numeroLlamado: Integer
    - fechaHora: DateTime
    - cupoMaximo: Integer
  }

  class ActaExamen {
    - numeroActa: String
    - fechaCierre: DateTime
    - calificacionDefinitiva: Decimal
    - cerrada: Boolean
  }

  InscripcionCursada "0..*" --> "1" Cursada : corresponde a
  InscripcionExamen "0..*" --> "1" MesaExamen : para rendir en
  MesaExamen "1" *-- "1" ActaExamen : genera
}

' ==========================================
' 3. MÓDULO INSTITUCIONAL Y PLANES
' ==========================================
package "3. Estructura Academica" as PkgAcademico {
  class Facultad {
    - nombre: String
    - direccion: String
    - modulo: String
    - decano: String
    - horario: String
  }

  class Carrera {
    - codigoCarrera: String
    - nombre: String
    - descripcion: String
  }

  class PlanDeEstudio {
    - codigoPlan: String
    - anioVigencia: Integer
  }

  class Materia {
    - codigoMateria: String
    - nombreMateria: String
    - cargaHoraria: Integer
    - regimen: RegimenCursada
  }

  Facultad "1" *-- "1..*" Carrera : posee
  Carrera "1" *-- "1..*" PlanDeEstudio : compuesta por
  PlanDeEstudio "1..*" o-- "1..*" Materia : define
  Materia "0..*" --> "0..*" Materia : correlativa de
}

' ==========================================
' 4. MÓDULO EDILICIO
' ==========================================
package "4. Infraestructura Edilicia" as PkgEdilicio {
  class Aula {
    - nombreAula: String
    - descripcionAula: String
    - dimensionAula: Decimal
    - capacidadMaxima: Integer
    - tipo: TipoAula
    - habilitada: Boolean
    + requiereMantenimiento(): Boolean
  }

  class Equipamiento {
    - nombreEquipo: String
    - cantidad: Integer
    - descripcion: String
  }

  Aula "1" o-- "0..*" Equipamiento : cuenta con
}

' ==========================================
' 5. ENUMERADOS COMPACTOS
' ==========================================
package "5. Enumerados" as PkgEnums {
  enum EstadoMateria {
    REGULAR
    APROBADO
    PROMOCIONADO
    LIBRE
  }
  enum EstadoAlumno {
    CURSANDO
    NO_CURSANDO
  }
  enum RegimenCursada {
    ANUAL
    CUATRIMESTRAL
  }
  enum TipoAula {
    AULA_COMUN
    LABORATORIO_INFORMATICA
    AUDITORIO
  }
  
  ' Alineación interna para que queden en una sola fila/columna prolija
  EstadoMateria -[hidden]-> EstadoAlumno
  EstadoAlumno -[hidden]-> RegimenCursada
  RegimenCursada -[hidden]-> TipoAula
}

' ==========================================
' CONEXIONES ENTRE MÓDULOS
' ==========================================
Alumno "1" --> "0..*" InscripcionCursada : realiza
Alumno "1" --> "0..*" InscripcionExamen : se inscribe a

Docente "1..*" --> "1..*" Cursada : asignado a
Docente "1..3" --> "0..*" MesaExamen : integra tribunal

Bedelia "1" --> "0..*" MesaExamen : crea llamados
Bedelia "1" --> "0..*" Aula : gestiona / inhabilita

Cursada "0..*" --> "1" Materia : dicta
MesaExamen "0..*" --> "1" Materia : evalua
Cursada "0..*" --> "1" Aula : se dicta en
MesaExamen "0..*" --> "1" Aula : se rinde en

Facultad "1" o-- "0..*" Persona : pertenece
Facultad "1" *-- "1..*" Aula : dispone de

@enduml
